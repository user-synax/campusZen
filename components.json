{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": true,
  "tsx": false,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils"
  },
  "registries": {
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@spectrumui": "https://ui.spectrumhq.in/r/{name}.json",
    "@beui": "https://beui.dev/r/{name}.json",
    "@iconiq": "https://iconiqui.com/r/{name}.json"
  }
}
