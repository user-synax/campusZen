# ━━━ CampusZen chat backend ━━━
# This backend owns DM + Group chat (messages, typing, presence, unread, read
# receipts). It connects to the SAME Mongo database as the Next.js app and reuses
# the existing DMConversation / DMMessage / GroupChat / GroupMessage collections.
# It does NOT handle notifications, voice (LiveKit), posts, or any other feature —
# those stay on the Next.js + Pusher stack.

# MongoDB connection (must match the Next.js app's MONGODB_URI exactly)
MONGODB_URI

# JWT secret — MUST equal the Next.js app's JWT_SECRET (lib/config.js). Used to
# verify the short-lived handshake token minted by /api/chat-socket-token.
JWT_SECRET

# Port the Express/Socket.IO server listens on
PORT=4000

# Allowed browser origins for CORS + Socket.IO handshake.
# Production campuszen origin + local dev origin.
CLIENT_ORIGIN=https://campuszen.tech
DEV_ORIGIN=http://localhost:3000

# Public URL of THIS backend, used by the frontend socket client and referenced
# in CSP. Example Render URL:
CHAT_BACKEND_URL

# Internal shared secret used by this backend to call back into the Next.js app
# to create chat-message notifications (server-to-server, best-effort). Must
# match NEXT_PUBLIC_CHAT_BACKEND_SECRET / CHAT_BACKEND_SECRET on the Next side.
CHAT_BACKEND_SECRET=change-me-internal-secret

# Base URL of the Next.js app, used for the best-effort notification callback.
NEXT_APP_URL=https://campuszen.tech
